{
  "name": "linux-security-monitor-ru",
  "version": "2.3.0",
  "language": "ru",
  "description": "Субагент безопасности Linux для Hermes. Мониторит только критические и опасные события, отправляет ежедневную сводку с идентификацией сервера. Полное покрытие портов и детекция изменений.",
  "author": "Security Team",
  "license": "MIT",
  "tags": ["security", "monitoring", "linux", "daily-report", "russian", "anti-spam", "port-monitoring"],

  "schedule": {
    "frequency": "daily",
    "time": "06:00",
    "timezone": "UTC"
  },

  "permissions": [
    "read:system",
    "read:network",
    "read:logs",
    "read:config_files",
    "execute:readonly_commands"
  ],

  "constraints": {
    "read_only": true,
    "no_network_access": true,
    "no_file_modification": true,
    "timeout_seconds": 120,
    "max_output_size_kb": 512
  },

  "tools": [
    {
      "name": "ai_security_scan",
      "type": "ai_controller",
      "description": "ИИ-субагент для интеллектуального анализа безопасности с принятием решений",
      "entry_point": "python3 ai_sub_agent.py --format hermes",
      "severity_filter": ["critical", "high"]
    },
    {
      "name": "check_updates",
      "type": "system",
      "description": "Проверка доступных обновлений пакетов",
      "severity_filter": ["high"]
    },
    {
      "name": "check_ssh",
      "type": "audit",
      "description": "Аудит конфигурации SSH на предмет уязвимостей",
      "severity_filter": ["critical", "high"]
    },
    {
      "name": "check_listening_ports",
      "type": "network",
      "description": "Мониторинг всех слушающих портов с детекцией изменений",
      "severity_filter": ["critical", "high"]
    },
    {
      "name": "check_firewall",
      "type": "network",
      "description": "Проверка статуса файрвола (UFW/nftables/iptables)",
      "severity_filter": ["high"]
    },
    {
      "name": "check_failed_logins",
      "type": "audit",
      "description": "Анализ неудачных попыток входа по SSH",
      "severity_filter": ["high"]
    },
    {
      "name": "check_privileged_users",
      "type": "audit",
      "description": "Проверка пользователей с привилегиями (UID 0, sudo)",
      "severity_filter": ["critical"]
    },
    {
      "name": "check_systemd",
      "type": "system",
      "description": "Проверка упавших systemd сервисов",
      "severity_filter": ["high"]
    },
    {
      "name": "check_disk",
      "type": "system",
      "description": "Мониторинг заполненности дисков и inode",
      "severity_filter": ["high"]
    },
    {
      "name": "check_selinux",
      "type": "audit",
      "description": "Проверка статуса SELinux/AppArmor",
      "severity_filter": ["high"]
    },
    {
      "name": "check_cron",
      "type": "audit",
      "description": "Поиск подозрительных cron заданий",
      "severity_filter": ["high"]
    },
    {
      "name": "check_processes",
      "type": "network",
      "description": "Проверка процессов на подозрительную активность (майнеры, backdoor)",
      "severity_filter": ["critical"]
    },
    {
      "name": "check_env_vars",
      "type": "audit",
      "description": "Проверка переменных окружения на секреты",
      "severity_filter": ["high"]
    },
    {
      "name": "check_oom",
      "type": "system",
      "description": "Проверка OOM killer событий",
      "severity_filter": ["high"]
    },
    {
      "name": "check_zombie_processes",
      "type": "system",
      "description": "Проверка zombie процессов",
      "severity_filter": ["high"]
    },
    {
      "name": "check_promiscuous_mode",
      "type": "network",
      "description": "Проверка интерфейсов в promiscuous mode",
      "severity_filter": ["high"]
    },
    {
      "name": "check_audit_status",
      "type": "audit",
      "description": "Проверка статуса auditd",
      "severity_filter": ["high"]
    },
    {
      "name": "check_time_changes",
      "type": "audit",
      "description": "Проверка изменений системного времени",
      "severity_filter": ["high"]
    },
    {
      "name": "check_network_errors",
      "type": "network",
      "description": "Проверка сетевых ошибок",
      "severity_filter": ["high"]
    }
  ],

  "alerting": {
    "critical": {
      "immediate": true,
      "channels": ["telegram", "email", "slack"],
      "deduplication_window_minutes": 60,
      "escalation_after_minutes": 15
    },
    "high": {
      "immediate": false,
      "daily_summary": true,
      "channels": ["telegram"],
      "deduplication_window_minutes": 1440
    },
    "medium": {
      "suppress": true
    },
    "low": {
      "suppress": true
    },
    "info": {
      "suppress": true
    }
  },

  "response_schema": {
    "type": "object",
    "properties": {
      "timestamp": {"type": "string", "format": "date-time"},
      "mode": {"type": "string", "enum": ["critical_high_only"]},
      "schedule": {"type": "string", "enum": ["daily"]},
      "server_hostname": {"type": "string"},
      "server_ip": {"type": "array", "items": {"type": "string"}},
      "total_findings": {"type": "integer"},
      "critical_count": {"type": "integer"},
      "high_count": {"type": "integer"},
      "status": {"type": "string", "enum": ["clean", "issues_found"]},
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "check": {"type": "string"},
            "severity": {"type": "string", "enum": ["critical", "high"]},
            "summary": {"type": "string"},
            "details": {"type": "string"},
            "remediation": {"type": "string"},
            "timestamp": {"type": "string", "format": "date-time"},
            "server_hostname": {"type": "string"},
            "server_ip": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["check", "severity", "summary"]
        }
      }
    },
    "required": ["timestamp", "server_hostname", "total_findings", "status"]
  },

  "integration": {
    "hermes": {
      "import_command": "hermes import-agent ./hermes-agent-card.json",
      "trigger_format": "json",
      "output_format": "markdown",
      "chat_integration": true
    }
  },

  "anti_spam": {
    "enabled": true,
    "daily_summary_only": true,
    "suppress_if_no_issues": true,
    "min_severity": "high",
    "deduplication": {
      "enabled": true,
      "window_hours": 24,
      "hash_algorithm": "sha256"
    },
    "rate_limit": {
      "max_digests_per_day": 1,
      "max_alerts_per_hour": 5
    },
    "quiet_hours": {
      "enabled": false,
      "start": "22:00",
      "end": "08:00"
    }
  },

  "server_identification": {
    "include_hostname": true,
    "include_ip_addresses": true,
    "include_timestamp": true
  },

  "metadata": {
    "created": "2025-01-15",
    "updated": "2025-01-15",
    "tags": ["security", "linux", "monitoring", "daily-report", "russian", "anti-spam"],
    "compatibility": ["ubuntu", "debian", "centos", "rhel", "fedora"],
    "python_version": "3.6+"
  }
}
