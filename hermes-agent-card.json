{
  "name": "security-monitor",
  "version": "1.0.0",
  "description": "Read-only sub-agent for Linux server security monitoring",
  "author": "Security Monitor Team",
  "license": "MIT",
  "tags": ["security", "monitoring", "linux", "audit", "read-only"],
  
  "hermes_config": {
    "agent_type": "sub-agent",
    "execution_mode": "sandbox",
    "priority": "high",
    "auto_trigger": false,
    
    "capabilities": [
      "security_audit",
      "vulnerability_detection",
      "compliance_check",
      "risk_assessment"
    ],
    
    "permissions": {
      "filesystem": {
        "read": [
          "/etc/os-release",
          "/etc/ssh/sshd_config",
          "/etc/crontab",
          "/etc/passwd",
          "/etc/hosts.allow",
          "/etc/hosts.deny",
          "/var/log/auth.log"
        ],
        "write": [],
        "execute": [
          "/usr/bin/uname",
          "/usr/bin/df",
          "/usr/bin/free",
          "/usr/bin/ss",
          "/usr/bin/systemctl",
          "/usr/sbin/ufw",
          "/usr/sbin/nft",
          "/usr/sbin/iptables",
          "/usr/bin/journalctl",
          "/usr/bin/tail",
          "/usr/bin/awk",
          "/usr/bin/getent",
          "/usr/bin/apt-get",
          "/usr/bin/dnf",
          "/usr/bin/fail2ban-client",
          "/usr/bin/docker",
          "/usr/sbin/getenforce",
          "/usr/sbin/aa-status",
          "/usr/sbin/sysctl",
          "/usr/bin/last",
          "/usr/bin/who",
          "/usr/bin/crontab",
          "/usr/bin/lsof",
          "/usr/bin/ps",
          "/usr/bin/env"
        ]
      },
      "network": {
        "outbound": [],
        "inbound": []
      },
      "process": {
        "spawn": true,
        "constraints": ["read_only", "no_modification"]
      }
    },
    
    "tools": [
      {
        "name": "security_audit",
        "description": "Runs comprehensive read-only Linux security checks and returns structured report",
        "entry_point": "python3 /opt/security-monitor/security_monitor.py",
        "default_args": ["--format", "json"],
        "timeout_sec": 120,
        "retry_count": 0,
        "output_format": "json",
        "cache_enabled": false,
        "cache_ttl_sec": 0
      },
      {
        "name": "security_audit_markdown",
        "description": "Runs security checks and returns human-readable Markdown report",
        "entry_point": "python3 /opt/security-monitor/security_monitor.py",
        "default_args": ["--format", "markdown"],
        "timeout_sec": 120,
        "retry_count": 0,
        "output_format": "text",
        "cache_enabled": false,
        "cache_ttl_sec": 0
      },
      {
        "name": "security_audit_critical",
        "description": "Runs security checks with strict mode - exits with code 2 if critical findings",
        "entry_point": "python3 /opt/security-monitor/security_monitor.py",
        "default_args": ["--format", "json", "--fail-on", "critical"],
        "timeout_sec": 120,
        "retry_count": 0,
        "output_format": "json",
        "cache_enabled": false,
        "cache_ttl_sec": 0
      }
    ],
    
    "constraints": [
      "no_modification",
      "no_package_install",
      "no_service_restart",
      "no_ip_blocking",
      "no_secret_exfiltration",
      "report_only",
      "read_only_filesystem",
      "no_network_access"
    ],
    
    "system_prompt": "Ты — саб-агент безопасности сервера (Security Monitor Sub-Agent). Твоя задача — только мониторинг, диагностика и рекомендации. Ты не изменяешь конфигурацию сервера, не устанавливаешь пакеты, не перезапускаешь сервисы и не блокируешь IP без явного подтверждения человека. Анализируй вывод инструмента security_audit, объясняй риски понятным языком и предлагай безопасные remediation-шаги отдельно. Не выводи секреты, приватные ключи, пароли и содержимое чувствительных файлов, если это не требуется для диагностики. Если есть critical-находки, помечай их в начале отчёта.",
    
    "response_schema": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "generated_at": {"type": "string", "format": "date-time"},
            "agent": {"type": "string"},
            "mode": {"type": "string"},
            "uname": {"type": "string"},
            "os": {"type": "string"}
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
              "title": {"type": "string"},
              "detail": {"type": "string"},
              "remediation": {"type": "string"}
            },
            "required": ["severity", "title"]
          }
        }
      },
      "required": ["meta", "findings"]
    },
    
    "alerting": {
      "enabled": true,
      "triggers": [
        {
          "condition": "finding.severity == 'critical'",
          "action": "immediate_alert",
          "channels": ["console", "log"]
        },
        {
          "condition": "finding.severity == 'high'",
          "action": "high_priority_notification",
          "channels": ["console", "log"]
        }
      ]
    },
    
    "logging": {
      "level": "info",
      "destination": "stdout",
      "include_findings": true,
      "include_metadata": true
    }
  },
  
  "installation": {
    "requirements": [
      "Python 3.7+",
      "Linux server (Debian/Ubuntu, RHEL/CentOS/Fedora)",
      "Root or sudo access for some checks"
    ],
    "optional_dependencies": [
      "ufw or nftables or iptables",
      "fail2ban",
      "docker",
      "sshd"
    ],
    "install_script": "sudo mkdir -p /opt/security-monitor && sudo cp security_monitor.py /opt/security-monitor/ && sudo chmod +x /opt/security-monitor/security_monitor.py",
    "verify_command": "python3 /opt/security-monitor/security_monitor.py --help"
  }
}
