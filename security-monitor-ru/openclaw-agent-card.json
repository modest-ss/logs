{
  "agent_id": "linux-security-monitor-ru",
  "version": "2.1.0",
  "name": "Linux Security Monitor (RU)",
  "description": "Sub-agent for Linux server monitoring. Only critical and high severity events, daily summary with server identification.",
  "language": "ru",
  "interface": {
    "type": "python_script",
    "script": "security_monitor.py",
    "interpreter": "python3",
    "format": "json",
    "timeout_seconds": 120,
    "working_directory": "/opt/security-monitor",
    "environment": {
      "PYTHONIOENCODING": "utf-8",
      "LC_ALL": "C.UTF-8"
    },
    "arguments": ["--daily-summary", "--format", "json"]
  },
  "actions": [
    {
      "id": "daily_scan",
      "name": "Daily Security Scan",
      "trigger": "schedule",
      "command": "python3 security_monitor.py --daily-summary --format json",
      "response_handler": "process_findings"
    },
    {
      "id": "on_demand_scan",
      "name": "On-Demand Scan",
      "trigger": "manual",
      "command": "python3 security_monitor.py --format json",
      "response_handler": "process_findings"
    },
    {
      "id": "critical_alert",
      "name": "Immediate Alert",
      "trigger": "finding_severity_critical",
      "command": "send_alert_immediate",
      "channels": ["telegram", "email", "slack"],
      "include_server_info": true
    }
  ],
  "monitoring": {
    "frequency": "daily",
    "schedule": {
      "cron": "0 6 * * *",
      "timezone": "UTC"
    },
    "quiet_hours": {
      "enabled": false,
      "start": "22:00",
      "end": "08:00"
    },
    "deduplication": {
      "enabled": true,
      "window_minutes": 1440,
      "key_fields": ["check", "severity", "summary"],
      "hash_based": true,
      "similarity_threshold": 0.8
    },
    "thresholds": {
      "critical": {
        "immediate_alert": true,
        "max_per_day": 10,
        "include_server_info": true
      },
      "high": {
        "daily_summary": true,
        "max_per_day": 50,
        "include_server_info": true
      }
    },
    "server_identification": {
      "enabled": true,
      "fields": ["hostname", "server_id", "ip_addresses"]
    }
  },
  "integration": {
    "openclaw": {
      "import_command": "openclaw agent import ./openclaw-agent-card.json",
      "api_version": "v2",
      "callback_url": "https://openclaw.internal/api/v2/agents/linux-security-monitor-ru/callback",
      "auth_method": "api_key",
      "server_identification": true
    },
    "notification_channels": {
      "telegram": {
        "enabled": true,
        "bot_token_env": "TELEGRAM_BOT_TOKEN",
        "chat_id_env": "SECURITY_CHAT_ID",
        "message_template": "[{server.hostname}] {finding.summary}"
      },
      "email": {
        "enabled": true,
        "smtp_host_env": "SMTP_HOST",
        "recipients_env": "SECURITY_EMAIL_RECIPIENTS",
        "subject_template": "[Security] {server.hostname}: {critical_count} critical, {high_count} high"
      },
      "slack": {
        "enabled": false,
        "webhook_url_env": "SLACK_WEBHOOK_URL",
        "message_template": "*[{server.hostname}]* {finding.summary}"
      }
    }
  },
  "filters": {
    "severity_whitelist": ["critical", "high"],
    "checks_enabled": [
      "system_updates",
      "ssh_config",
      "firewall",
      "listening_ports",
      "failed_ssh_logins",
      "privileged_users",
      "systemd_failed",
      "disk_usage",
      "selinux",
      "sysctl",
      "cron_jobs",
      "processes_connections",
      "env_vars"
    ],
    "exclude_patterns": ["test_", "debug_"]
  },
  "response_handlers": {
    "process_findings": {
      "type": "conditional",
      "rules": [
        {
          "condition": "total_findings == 0",
          "action": "log_only",
          "message": "System clean, no threats detected"
        },
        {
          "condition": "skipped == true",
          "action": "log_only",
          "message": "Report skipped due to anti-spam: {skip_reason}"
        },
        {
          "condition": "critical_count > 0",
          "action": "alert_immediate",
          "template": "critical_alert",
          "include_server": true
        },
        {
          "condition": "high_count > 0",
          "action": "daily_digest",
          "template": "daily_summary",
          "include_server": true
        }
      ]
    }
  },
  "anti_spam": {
    "enabled": true,
    "strategies": [
      {
        "name": "severity_filter",
        "description": "Filter by severity level",
        "config": {
          "min_severity": "high"
        }
      },
      {
        "name": "daily_digest",
        "description": "Consolidate into daily summary",
        "config": {
          "digest_time": "06:00",
          "include_clean_report": false
        }
      },
      {
        "name": "deduplication",
        "description": "Remove duplicates with hash comparison",
        "config": {
          "window_hours": 24,
          "compare_fields": ["check", "summary"],
          "hash_based": true,
          "similarity_threshold": 0.8
        }
      },
      {
        "name": "rate_limit",
        "description": "Limit notification frequency",
        "config": {
          "max_alerts_per_hour": 5,
          "max_digests_per_day": 1
        }
      },
      {
        "name": "suppress_no_issues",
        "description": "Don't send reports when no issues found",
        "config": {
          "suppress_if_clean": true
        }
      }
    ]
  },
  "logging": {
    "level": "info",
    "file": "/var/log/security-monitor/agent.log",
    "rotation": {
      "max_size_mb": 50,
      "max_files": 5
    },
    "format": "%(asctime)s - %(levelname)s - %(message)s"
  },
  "metadata": {
    "created": "2025-01-15T00:00:00Z",
    "updated": "2025-01-15T00:00:00Z",
    "author": "Security Team",
    "license": "MIT",
    "tags": ["security", "linux", "monitoring", "daily-report", "russian", "no-spam", "server-id", "anti-spam"],
    "compatibility": {
      "os": ["ubuntu", "debian", "centos", "rhel", "rocky", "alma"],
      "python": ">=3.6",
      "openclaw": ">=2.0"
    }
  }
}
